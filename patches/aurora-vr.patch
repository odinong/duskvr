+namespace aurora::xr {
+namespace {
+uint32_t g_overrideWidth = 0;
+uint32_t g_overrideHeight = 0;
+} // namespace
+
+void set_framebuffer_override(uint32_t width, uint32_t height) {
+  if (width == 0 || height == 0) {
+    width = height = 0;
+  }
+  if (width == g_overrideWidth && height == g_overrideHeight) {
+    return;
+  }
+  g_overrideWidth = width;
+  g_overrideHeight = height;
+  window::request_frame_buffer_resize();
+}
+
+bool framebuffer_override(uint32_t& width, uint32_t& height) {
+  if (g_overrideWidth == 0 || g_overrideHeight == 0) {
+    return false;
+  }
+  width = g_overrideWidth;
+  height = g_overrideHeight;
+  return true;
+}
+} // namespace aurora::xr
