diff --git a/lib/xr.cpp b/lib/xr.cpp
new file mode 100644
index 0000000..aafeebe
--- /dev/null
+++ b/lib/xr.cpp
@@ -0,0 +1,30 @@
+#include "aurora/xr.hpp"
+
+#include "gfx/frame.hpp"
+#include "internal.hpp"
+#include "webgpu/gpu.hpp"
+
+namespace aurora::xr {
+namespace {
+FrameHook g_nextFrameHook;
+bool g_nextFrameWindowPresent = true;
+} // namespace
+
+namespace detail {
+FrameHook take_frame_hook() { return std::exchange(g_nextFrameHook, {}); }
+bool take_window_present() { return std::exchange(g_nextFrameWindowPresent, true); }
+} // namespace detail
+
+void set_next_frame_hook(FrameHook hook) { g_nextFrameHook = std::move(hook); }
+
+void set_next_frame_window_present(bool enabled) { g_nextFrameWindowPresent = enabled; }
+
+void synchronize() { gfx::gpu_synchronize(); }
+
+wgpu::Device device() { return webgpu::g_device; }
+
+wgpu::Queue queue() { return webgpu::g_queue; }
+
+wgpu::BackendType backend_type() { return webgpu::g_backendType; }
+
+} // namespace aurora::xr
