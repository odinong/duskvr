@@ -0,0 +1,47 @@
+#pragma once
+
+#include <webgpu/webgpu_cpp.h>
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+// Hooks for stereo / XR presentation. All setters must be called on the game thread.
+namespace aurora::xr {
+
+struct PresentSource {
+  wgpu::Texture texture;
+  wgpu::TextureView view;
+  wgpu::TextureFormat format;
+  uint32_t width;
+  uint32_t height;
+};
+
+using AfterSubmitCallback = std::function<void()>;
+
+// Runs on the render worker while the frame encoder is open, before the window present pass.
+// Record work on `encoder` (leave no pass open). Callbacks appended to `afterSubmit` run once the
+// frame's command buffer has been submitted to the queue.
+using FrameHook = std::function<void(wgpu::CommandEncoder& encoder, const PresentSource& source,
+                                     std::vector<AfterSubmitCallback>& afterSubmit)>;
+
+// Installs a hook for the next aurora_end_frame only.
+void set_next_frame_hook(FrameHook hook);
+
+// Whether the next aurora_end_frame presents to the window surface (default true). Resets after
+// every frame.
+void set_next_frame_window_present(bool enabled);
+
+// Overrides the content framebuffer (EFB) size, independent of the window. 0x0 clears the
+// override. Takes effect on the next swapchain refresh.
+void set_framebuffer_override(uint32_t width, uint32_t height);
+bool framebuffer_override(uint32_t& width, uint32_t& height);
+
+// Blocks until the render worker has drained and submitted all queued frames.
+void synchronize();
+
+wgpu::Device device();
+wgpu::Queue queue();
+wgpu::BackendType backend_type();
+
+} // namespace aurora::xr
